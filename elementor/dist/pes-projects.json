            {
              "id": "53fc446",
              "elType": "widget",
              "widgetType": "text-editor",
              "isInner": false,
              "settings": {
                "editor": "<p>Filter by type, click a photo to see more of the project, and open the details for size and location.</p>",
                "_css_classes": "pes-lead pes-center"
              },
              "elements": []
