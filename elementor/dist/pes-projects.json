            {
              "id": "ab779ca",
              "elType": "widget",
              "widgetType": "html",
              "isInner": false,
              "settings": {
                "html": "<div class=\"pes-filter\" role=\"group\" aria-label=\"Filter projects\"><button type=\"button\" class=\"is-active\" data-filter=\"all\" aria-pressed=\"true\">All</button><button type=\"button\" data-filter=\"commercial-solar\" aria-pressed=\"false\">Commercial Solar</button><button type=\"button\" data-filter=\"residential-solar\" aria-pressed=\"false\">Residential Solar</button><button type=\"button\" data-filter=\"solar-farms\" aria-pressed=\"false\">Solar Farms</button><button type=\"button\" data-filter=\"battery-storage\" aria-pressed=\"false\">Battery Storage</button><button type=\"button\" data-filter=\"ev-infrastructure\" aria-pressed=\"false\">EV Infrastructure</button><button type=\"button\" data-filter=\"electrical-infrastructure\" aria-pressed=\"false\">Electrical Infrastructure</button></div>\n<script>\n(function () {\n  function init(bar) {\n    if (bar.dataset.pesReady) return;\n    bar.dataset.pesReady = '1';\n    var sec = bar.closest('.pes-projects');\n    bar.querySelectorAll('button').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var f = btn.dataset.filter;\n        bar.querySelectorAll('button').forEach(function (b) {\n          b.classList.toggle('is-active', b === btn); b.setAttribute('aria-pressed', b === btn);\n        });\n        sec.querySelectorAll('.pes-proj-card').forEach(function (card) {\n          var show = f === 'all' || card.classList.contains('pes-cat-' + f);\n          card.classList.toggle('is-hidden', !show);\n        });\n      });\n    });\n  }\n  // links like /projects/#battery-storage open the page with that filter selected\n  function fromHash() {\n    var key = (location.hash || '').replace('#', '');\n    if (!key) return;\n    var btn = document.querySelector('.pes-filter button[data-filter=\"' + key + '\"]');\n    if (!btn) return;\n    btn.click();\n    var sec = btn.closest('.pes-projects');\n    if (sec) setTimeout(function () { sec.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 60);\n  }\n  function run() { document.querySelectorAll('.pes-filter').forEach(init); fromHash(); }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();\n  window.addEventListener('elementor/frontend/init', run);\n  window.addEventListener('hashchange', fromHash);\n})();\n</script>",
                "_css_classes": "pes-filter-widget"
              },
              "elements": []
